# BKK FloodWatch origin (fallback for the Cloudflare Tunnel, see HANDOFF.md / KI-501).
# Only Cloudflare edge IPs may connect; everything else is dropped. Refresh the ranges with
# infra/update-cloudflare-ips.sh (source: https://www.cloudflare.com/ips/, fetched 2026-09-26).
{
	auto_https off
	admin off
}

(cf_only) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 
	abort @not_cloudflare
	encode gzip
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}

# Cloudflare SSL mode "Full": HTTPS to origin with the self-signed origin cert in certs/.
https://flood.bejranonda.com:443 {
	tls /certs/cert.pem /certs/key.pem
	import cf_only
}

# Cloudflare SSL mode "Flexible": plain HTTP to origin (no redirect, to avoid loops).
http://:80 {
	import cf_only
}
