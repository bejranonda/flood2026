# ==============================================================================
# Bangkok & Central Thailand Flood Intelligence Engine 2026 (.env.example)
# ==============================================================================
# Copy this file to .env and configure your local credentials and tokens.
# Example: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Configuration (Zero Trust / Tunnel / Workers / Pages / DNS)
# ------------------------------------------------------------------------------
# API token with permissions for Cloudflare Tunnel, Workers, Pages, and DNS
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_DOMAIN=bejranonda.com
CLOUDFLARE_SUBDOMAIN=flood.bejranonda.com
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 2. Hydrological & Meteorological Telemetry APIs
# ------------------------------------------------------------------------------
# Hydro and Agro Informatics Institute (HAII / ThaiWater API v3)
THAIWATER_API_KEY=

# Thai Meteorological Department (TMD) Open Data API
TMD_API_KEY=

# Geo-Informatics and Space Technology Development Agency (GISTDA) Disaster Portal
GISTDA_API_KEY=

# Open-Meteo Weather & GloFAS API
OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# 3. Application Runtime & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PYTHON_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 4. Storage, Cache & Model Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/flood2026.db
REDIS_URL=redis://localhost:6379/0
DATA_CACHE_TTL_SECONDS=300
MODEL_REGISTRY_PATH=./models/registry
TELEMETRY_ARCHIVE_PATH=./data/telemetry_archive
