# ==============================================================================
# BKK FloodWatch 2026 — environment template (.env.example)
# ==============================================================================
# Copy to .env on the VPS and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real values. See docs/ARCHITECTURE.md §5.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime
# ------------------------------------------------------------------------------
APP_ENV=development            # development | production
LOG_LEVEL=info
TZ=Asia/Bangkok                # display timezone; all data is stored in UTC
# Services bind to localhost only; public traffic arrives via Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=https://flood.autobahn.bot

# ------------------------------------------------------------------------------
# 2. Cloudflare (Tunnel / Pages / DNS / cache purge) — see KNOWN_ISSUES KI-501
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_DOMAIN=autobahn.bot
CLOUDFLARE_SUBDOMAIN=flood.autobahn.bot
# Legacy alias (still served, same tunnel): flood.bejranonda.com
# Real tunnel tokens are long base64 strings (see HANDOFF.md §4.1; the API token needs Tunnel:Edit)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 3. Storage — Postgres + TimescaleDB + PostGIS (docs/ARCHITECTURE.md §3)
# ------------------------------------------------------------------------------
# docker compose builds DATABASE_URL from POSTGRES_PASSWORD (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://floodwatch:change_me@127.0.0.1:5432/floodwatch
TELEMETRY_ARCHIVE_PATH=./data/raw_archive
MODEL_REGISTRY_PATH=./models/registry

# Cloudflare R2 (S3-compatible) — raw archive replica + database backups
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=floodwatch-archive
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 4. Collectors — honest identification (docs/GUIDELINES.md §5, D-004)
# ------------------------------------------------------------------------------
HTTP_USER_AGENT=BKK-FloodWatch/0.2 (+https://flood.autobahn.bot; contact: CONTACT_EMAIL)
CONTACT_EMAIL=
HTTP_TIMEOUT_SECONDS=120       # HII rain_24h is several MB (KI-108)
DATA_CACHE_TTL_SECONDS=300
MIN_FREE_DISK_GB=2
# Optional Thai egress for geo-blocked public sources (BMA/DWR/Navy), D-014/D-016. Put ONE .ovpn in infra/openvpn/
# (git-ignored). Alternative: an SSH SOCKS tunnel to a Thai host you control -> socks5h://host.docker.internal:1080
THAI_EGRESS_PROXY=http://vpn:8888   # OpenVPN sidecar (docker compose --profile vpn); empty disables

# ------------------------------------------------------------------------------
# 5. Optional data keys — v1 runs WITHOUT them (docs/SOURCES.md §7)
# ------------------------------------------------------------------------------
# HII public endpoints need no key; only a formal HII agreement would add one.
THAIWATER_PARTNER_KEY=
# Thai Meteorological Department (free registration: uid + ukey)
TMD_UID=
TMD_UKEY=
# GISTDA API Gateway (free registration at api-gateway.gistda.or.th/v2)
# Daily satellite flood extent & flood recurrence (Sentinel-1 / COSMO-SkyMed)
GISTDA_API_KEY=
GISTDA_API_ENDPOINT=https://api-gateway.gistda.or.th/api/2.0/resources/features/flood/7days
# Documented at disaster.gistda.or.th/services/open-api (OpenAPI server .../api/2.0/resources): /features/flood/{1day,3days,
# 7days,30days}, /features/flood-freq; params limit, offset, bbox; key in the **API-Key header** (KI-510).

# Google Flood Forecasting API (Flood Hub): API key from a Google Cloud project after pilot acceptance (OWNER_ACTIONS).
# Not used by any collector yet; scripts/owner_status.py tests it with one tiny request.
GOOGLE_FLOOD_API_KEY=

# Copernicus Global Flood Monitoring (GFM, Sentinel-1 flood maps, CC BY 4.0). The maps themselves are readable WITHOUT
# an account (STAC: stac.eodc.eu/api/v1/collections/GFM). The account (email + password from the GFM portal) adds the
# api.gfm.eodc.eu/v2 API: POST /auth/login -> token valid 5 h -> areas of interest, product lists. Optional.
GFM_EMAIL=
GFM_PASSWORD=

# Google WeatherNext 3 (DeepMind AI rain forecasts) via BigQuery, research only (D-069): its real-time rain must never
# be shown or served by our API. A read-only service-account JSON key, placed in certs/ (git-ignored, mounted at /certs).
# Project/dataset = the linked dataset created when you subscribe to the WeatherNext listing in BigQuery Analytics Hub.
GOOGLE_APPLICATION_CREDENTIALS=
WEATHERNEXT_PROJECT=
WEATHERNEXT_DATASET=

# Copernicus Early Warning Data Store (EWDS): archived GloFAS forecasts (2019->) for the 3-7 day outlook backtest.
# Personal access token from ewds.climate.copernicus.eu (profile page) after accepting the CEMS-floods licence.
EWDS_API_KEY=

# Open-Meteo: keyless for non-commercial use; set only for a paid plan (KI-106)
OPEN_METEO_API_KEY=

# Secret for hashing feedback senders' IPs (rate limiting only; IPs are never stored). Generate: openssl rand -hex 32
FEEDBACK_SALT=

# 1 = 301-redirect flood.bejranonda.com pages and static files to flood.autobahn.bot (production since 2026-09-26, D-034).
# /api/* is never redirected: non-browser clients can't pass the autobahn.bot bot challenge (Q18, KI-506).
REDIRECT_LEGACY_HOST=0

# Optional AI feedback triage (D-022, D-030), used only by the background worker to triage feedback notes.
# The site works unchanged without it. Supported providers:
#   - glm: Zhipu AI GLM-4-Flash (fast, cost-effective, standard OpenAI-compatible API)
#   - cloudflare: Cloudflare Workers AI (@cf/aisingapore/gemma-sea-lion-v4-27b-it)
AI_ENABLED=1
AI_PROVIDER=glm                     # glm | cloudflare

# --- Option A: GLM (Zhipu AI) ---
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash

# --- Option B: Cloudflare Workers AI ---
# Prefer a dedicated token with only "Workers AI: Read"; if empty, the worker falls back
# to CLOUDFLARE_API_TOKEN. Free allocation: 10,000 neurons/day; capped at AI_DAILY_NEURON_BUDGET.
CF_AI_TOKEN=
AI_MODEL=@cf/aisingapore/gemma-sea-lion-v4-27b-it
AI_DAILY_NEURON_BUDGET=3000

